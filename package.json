{
  "name": "paxbot",
  "version": "3.1.0",
  "description": "Autonomous agent for Pax Historia (browser grand-strategy game)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "capture-auth": "tsx scripts/capture-auth-state.ts",
    "demo-auth": "tsx scripts/demo-auth-state.ts",
    "interactor": "tsx src/interactor.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-llm": "tsx scripts/test-llm-guardrails.ts",
    "manual-test": "tsx scripts/manual-llm-test.ts",
    "brain": "tsx src/brain/action-generator.ts",
    "init-campaign": "tsx scripts/init-campaign.ts",
    "switch-campaign": "tsx scripts/switch-campaign.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hiden500/PaxBot.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Hiden500/PaxBot/issues"
  },
  "homepage": "https://github.com/Hiden500/PaxBot#readme",
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@inquirer/prompts": "^8.5.2",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "openai": "^6.45.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.61.1",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.4",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
