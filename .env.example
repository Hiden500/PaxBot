# === Pax-Automata LLM API Keys ===
# Copy this file to .env and fill in the keys you have.
# Only need ONE provider to start — but more = better comparison.

# --- RECOMMENDED: Most likely to handle aggressive game actions ---

# Anthropic Claude (Sonnet 4.5 / Opus)
# Generally good with game/roleplay context when system prompt frames it clearly.
# Sonnet is fast + cheap; Opus is smartest. Both should handle coups/invasions in-game.
ANTHROPIC_API_KEY=

# OpenRouter (one key, many models — DeepSeek, Llama, Mistral, Grok, etc.)
# Best for testing many models cheaply. DeepSeek and Mistral are notably permissive.
OPENROUTER_API_KEY=

# --- WORTH TESTING ---

# OpenAI GPT (gpt-4o, gpt-4.1, o3)
# Hit-or-miss on aggressive actions. GPT-4o often refuses assassinations/coups
# even in game context. gpt-4.1 reportedly more flexible. Worth testing.
OPENAI_API_KEY=

# Google Gemini (via AI Studio)
# Most restrictive of the major providers for violent/political content.
# Likely to refuse assassinations and coups even with game framing.
# But it's what Pax Historia itself uses, so worth testing.
GOOGLE_API_KEY=

# xAI Grok
# Known for being the least restrictive major model. Should handle everything.
XAI_API_KEY=
