# === PaxBot LLM API Keys ===
# Copy this file to .env and fill in the keys you have.
# Only need ONE provider to start.
#
# Переключение провайдера: $env:LLM_PROVIDER="groq" (или gemini / openai)
# По умолчанию (если LLM_PROVIDER не задан): gemini

# --- RECOMMENDED: Groq (быстрый, дешёвый, без ограничений) ---
GROQ_API_KEY=

# --- Google Gemini (через AI Studio) ---
GOOGLE_API_KEY=

# --- OpenAI GPT ---
OPENAI_API_KEY=

# --- OpenAI-Compatible Providers (e.g., DeepSeek, Local LLM, etc.) ---
# Выберите LLM_PROVIDER="openaicompat" для использования этого провайдера
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
